# Local directory for Google Cloud SDK configuration
.gcloud/

# Local directory for Terraform tool downloads/plugins
.terraform/

# Terraform lock file containing provider hashes
.terraform.lock.hcl

# Local state files containing current environment status
*.tfstate
*.tfstate.backup
*.tfstate.lock.info

# Custom variables files that may contain passwords/secrets
*.tfvars
*.tfvars.json

# Exclude sensitive file overrides
secrets.auto.tfvars
secrets.auto.tfvars.json

# Crash log files from terraform runs
crash.log
crash.*.log

# Editor-specific files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS metadata files
.DS_Store
Thumbs.db
